import java.util.*;
public class Main{
    public static int MCMtab(int arr[],int i,int j,int dp[][]){
        if(i==j){
            return 0;
        }
        
        if(dp[i][j]!=-1){
            return dp[i][j];
        }
        int mincost=Integer.MAX_VALUE;
        for(int k=i;k<=j-1;k++){
            int cost1=MCMtab(arr,i,k,dp);
            int cost2=MCMtab(arr,k+1,j,dp);
            int cost3=arr[i-1]*arr[k]*arr[j];
            int finalcost=cost1+cost2+cost3;
            mincost=Math.min(finalcost,mincost);
        }
        return dp[i][j]=mincost;
    }
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int arr[]=new int[n];
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
        int dp[][]=new int[n][n];
        for(int i=0;i<n;i++){
            Arrays.fill(dp[i],-1);
        }
        System.out.println(MCMtab(arr,1,n-1,dp));
    }
}

