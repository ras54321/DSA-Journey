class Main {
    public static void main(String[] args) {
        int array[]={5,6,7,8,9,10,11,12};
        int key=8;
        System.out.println(linearsearch(array,key));
    }
    public static int linearsearch(int arr[],int key){
        for(int i=0;i<arr.length;i++){
            if(arr[i]==key){
                return i;
            }
        }
        return -1;
    }
    
}
