import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int arr[]=new int[n];
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
        insertionsort(arr);
    }
    public static void insertionsort(int array[]){
        int n=array.length;
        for(int i=1;i<n;i++){
            int j=i;
            for( j=1;j<n;j++){
            if(j>0 && array[j-1]>array[j]){
            int temp=array[j];
            array[j]=array[j-1];
            array[j-1]=temp;
                }
            }
            
        }
        for(int i=0;i<n;i++){
            System.out.print(array[i]+" ");
        }
        System.out.println();
    }
}
