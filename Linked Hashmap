import java.util.*;
public class Main{
    public static void  main(String[]args) {
        LinkedHashMap<String,Integer>lhm=new LinkedHashMap<>();
        lhm.put("India",100);
        lhm.put("China",150);
        lhm.put("USA",50);
        System.out.println(lhm);
        System.out.println(lhm.get("India"));
        System.out.println(lhm.get("Indonesia"));
        System.out.println(lhm.containsKey("India"));
        System.out.println(lhm.containsKey("Indonesia"));
        System.out.println(lhm.remove("USA"));
        System.out.println(lhm);
        System.out.println(lhm.size());
        lhm.clear();
        System.out.println(lhm.isEmpty());
        
        
    }
}
