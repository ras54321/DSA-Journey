import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int arr[]=new int[n];
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
        selectionsort(arr);
    }
    public static void selectionsort(int array[]){
        int n=array.length;
        for(int i=0;i<n;i++){
            int minindex=i;
            for(int j=i+1;j<n;j++){
                if(array[minindex]>array[j]){
                    minindex=j;
                }
            }
            int temp=array[minindex];
            array[minindex]=array[i];
            array[i]=temp;
        }
        for(int i=0;i<n;i++){
            System.out.print(array[i]+" ");
        }
        System.out.println();
    }
}
